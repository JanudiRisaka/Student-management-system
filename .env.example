# DEVELOPMENT ENVIRONMENT
#
# Setup:
# 1. Copy this file and rename it to .env.
# 2. Add your own MongoDB Atlas connection string.
# 3. Replace <development-database> with your development database name.
#
# Keep this file private: never commit .env to GitHub.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<development-database>?retryWrites=true&w=majority

PORT=3000