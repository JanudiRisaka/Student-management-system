# AUTOMATED TEST DATABASE CONFIGURATION
#
# 1. Copy this file and rename it to .env.test.
# 2. Create your own dedicated MongoDB Atlas test database.
# 3. Replace the placeholders with your own credentials.
# 4. Keep the database name exactly as stu-management-test.
# 5. Set TEST_DB_HOST to your complete MongoDB Atlas hostname.
# 6. Set ALLOW_TEST_DB_RESET=true only when you are ready to
#    allow the test runner to delete existing test database records.
#
# WARNING: Never use a development or production database.
# Never commit .env.test or share your database credentials.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/stu-management-test?retryWrites=true&w=majority

TEST_DB_HOST=<cluster-host>

ALLOW_TEST_DB_RESET=false

PORT=3001